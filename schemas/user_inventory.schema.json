{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hai-project.example/schemas/user_inventory.schema.json",
  "title": "UserInventory",
  "type": "object",
  "required": [
    "user_id",
    "owned_effect_types"
  ],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "owned_effect_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
