{
  "compressor": {
    "category": "dynamics",
    "reference_pedal": null,
    "source": "pedalboard",
    "class_name": "Compressor",
    "composite_of": null,
    "params": [
      { "name": "threshold_db", "maps_to": "Compressor.threshold_db", "type": "continuous", "unit": "dB", "range": [-60.0, 0.0], "options": null, "default": -18.0 },
      { "name": "ratio",        "maps_to": "Compressor.ratio",        "type": "continuous", "unit": null,  "scale": "log", "range": [1.0, 20.0],  "options": null, "default": 4.0 },
      { "name": "attack_ms",    "maps_to": "Compressor.attack_ms",    "type": "continuous", "unit": "ms",  "scale": "log", "range": [0.1, 100.0], "options": null, "default": 5.0 },
      { "name": "release_ms",   "maps_to": "Compressor.release_ms",   "type": "continuous", "unit": "ms",  "scale": "log", "range": [10.0, 1000.0], "options": null, "default": 100.0 }
    ]
  },

  "eq_3band": {
    "category": "tone_shaping",
    "reference_pedal": null,
    "source": "pedalboard",
    "class_name": "composite",
    "composite_of": ["LowShelfFilter", "PeakFilter", "HighShelfFilter"],
    "params": [
      { "name": "low_gain_db",  "maps_to": "LowShelfFilter.gain_db",        "type": "continuous", "unit": "dB", "range": [-12.0, 12.0], "options": null, "default": 0.0 },
      { "name": "mid_freq_hz",  "maps_to": "PeakFilter.cutoff_frequency_hz","type": "continuous", "unit": "Hz", "scale": "log", "range": [200.0, 5000.0], "options": null, "default": 1000.0 },
      { "name": "mid_gain_db",  "maps_to": "PeakFilter.gain_db",            "type": "continuous", "unit": "dB", "range": [-12.0, 12.0], "options": null, "default": 0.0 },
      { "name": "high_gain_db", "maps_to": "HighShelfFilter.gain_db",       "type": "continuous", "unit": "dB", "range": [-12.0, 12.0], "options": null, "default": 0.0 }
    ]
  },

"overdrive": {
    "category": "gain_stage",
    "reference_pedal": { "brand": "Boss", "model": "OD-1 OverDrive" },
    "source": "pedalboard",
    "class_name": "composite",
    "composite_of": ["HighpassFilter", "Distortion", "LowpassFilter", "Gain"],
    "params": [
      { "name": "hpf_freq", "maps_to": "HighpassFilter.cutoff_frequency_hz", "type": "continuous", "unit": "Hz", "range": [150.0, 250.0], "options": null, "default": 200.0 },
      { "name": "drive", "maps_to": "Distortion.drive_db", "type": "continuous", "unit": "dB", "range": [20.0, 35.0], "options": null, "default": 25.0 },
      { "name": "lpf_freq", "maps_to": "LowpassFilter.cutoff_frequency_hz", "type": "continuous", "unit": "Hz", "range": [3000.0, 5000.0], "options": null, "default": 4000.0 },
      { "name": "level", "maps_to": "Gain.gain_db", "type": "continuous", "unit": "dB", "range": [0.0, 8.0], "options": null, "default": 0.0 }
    ]
  },

  "distortion": {
    "category": "gain_stage",
    "reference_pedal": { "brand": "Boss", "model": "DS-1 Distortion" },
    "source": "pedalboard",
    "class_name": "composite",
    "composite_of": ["HighpassFilter", "Distortion", "Clipping", "LowpassFilter", "Gain"],
    "fixed_params": {
      "Clipping.threshold_db": -3.0
    },
    "params": [
      { "name": "hpf_freq", "maps_to": "HighpassFilter.cutoff_frequency_hz", "type": "continuous", "unit": "Hz", "range": [32.0, 48.0], "options": null, "default": 40.0 },
      { "name": "dist", "maps_to": "Distortion.drive_db", "type": "continuous", "unit": "dB", "range": [20.0, 35.0], "options": null, "default": 30.0 },
      { "name": "lpf_freq", "maps_to": "LowpassFilter.cutoff_frequency_hz", "type": "continuous", "unit": "Hz", "range": [3000.0, 8000.0], "options": null, "default": 5000.0 },
      { "name": "level", "maps_to": "Gain.gain_db", "type": "continuous", "unit": "dB", "range": [0.0, 8.0], "options": null, "default": 0.0 }
    ]
  },

  "fuzz": {
    "category": "gain_stage",
    "reference_pedal": { "brand": "Boss", "model": "FZ-1W Waza Craft Fuzz" },
    "source": "pedalboard",
    "class_name": "composite",
    "composite_of": ["Distortion", "Clipping", "PeakFilter", "LowpassFilter", "Gain"],
    "fixed_params": {
      "Clipping.threshold_db": -6.0
    },
    "params": [
      { "name": "fuzz", "maps_to": "Distortion.drive_db", "type": "continuous", "unit": "dB", "range": [20.0, 35.0], "options": null, "default": 25.0 },
      { "name": "notch_freq", "maps_to": "PeakFilter.cutoff_frequency_hz", "type": "continuous", "unit": "Hz", "range": [850.0, 1150.0], "options": null, "default": 1000.0 },
      { "name": "notch_gain", "maps_to": "PeakFilter.gain_db", "type": "continuous", "unit": "dB", "range": [-9.0, -5.0], "options": null, "default": -7.0 },
      { "name": "lpf_freq", "maps_to": "LowpassFilter.cutoff_frequency_hz", "type": "continuous", "unit": "Hz", "range": [2000.0, 3000.0], "options": null, "default": 2500.0 },
      { "name": "level", "maps_to": "Gain.gain_db", "type": "continuous", "unit": "dB", "range": [0.0, 8.0], "options": null, "default": 0.0 }
    ]
  }
}
